---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>Golden Era</title>
  </head>
  <body>
    <!-- 
      ::::::::   ::::::::  :::        :::::::::  :::::::::: ::::    ::: 
    :+:    :+: :+:    :+: :+:        :+:    :+: :+:        :+:+:   :+:  
   +:+        +:+    +:+ +:+        +:+    +:+ +:+        :+:+:+  +:+   
  :#:        +#+    +:+ +#+        +#+    +:+ +#++:++#   +#+ +:+ +#+    
 +#+   +#+# +#+    +#+ +#+        +#+    +#+ +#+        +#+  +#+#+#     
#+#    #+# #+#    #+# #+#        #+#    #+# #+#        #+#   #+#+#      
########   ########  ########## #########  ########## ###    ####       

                    :::::::::: :::::::::      ::: 
                   :+:        :+:    :+:   :+: :+:
                  +:+        +:+    +:+  +:+   +:+
                 +#++:++#   +#++:++#:  +#++:++#++:
                +#+        +#+    +#+ +#+     +#+ 
               #+#        #+#    #+# #+#     #+#  
              ########## ###    ### ###     ###   
-->
    <div class="page-wrapper">
      <Nav />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Inter";
    src: url(/fonts/InterFont.ttf);
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Chillax";
    src: url(/fonts/Chillax-Variable.ttf);
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "Theonory";
    src: url(/fonts/Theonory-Regular.ttf);
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: "NewTitle";
    src: url(/fonts/NewTitle.otf); 
    font-weight: 100;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --font-size-small: 1rem;
    --font-size-sm: 1.4rem;
    --font-size-medium: 1.618rem;
    --font-size-large: 2.618rem;
    --font-size-xlarge: 4.236rem;
    --font-size-xxlarge: 6.854rem;
    --font-size-larger: 11.089772rem;
    --font-size-bigger: 17.9432511rem;

    --margin-small: 1rem;
    --margin-medium: 2rem;
    --margin-large: 4rem;
    --margin-xlarge: 8rem;
    --margin-xxlarge: 12rem;
    --margin-xxxlarge: 16rem;

    --color-white: #ffffff;
    --color-black: #0e0b02;
    --color-background: #0e0b02;

    --color-primary-50: #faf1da;
    --color-primary-100: #f5e3b6;
    --color-primary-200: #f0d491;
    --color-primary-300: #eac66c;
    --color-primary-400: #e5b848;
    --color-primary-500: #e0aa23;
    --color-primary-600: #bd8f1b;
    --color-primary-700: #977215;
    --color-primary-800: #725610;
    --color-primary-900: #4c390b;
    
    --border-radius: 5rem;
  }

  ::selection {
    background-color: var(--color-primary-500);
    color: var(--color-black);
  }

  ::-moz-selection {
    background-color: var(--color-primary-500);
    color: var(--color-white);
  }
  footer ::selection {
    background-color: var(--color-background);
    color: var(--color-primary-500);
  }

  footer ::-moz-selection {
    background-color: var(--color-background);
    color: var(--color-primary-500);
  }
  

  .element {
    cursor: url("/src/assets/logos/goldensun.svg"), auto;
  }

  .page-wrapper {
    display: grid;
    min-height: 100dvh;
    grid-template-rows: auto 1fr auto;
  }
  html {
    font-size: 62.5%;
  }

  *,
  *::before,
  *::after {
    box-sizing: inherit;
    min-width: 0;
  }

  body {
    font-size: 1.6rem; /* 1rem = 10px.*/
    font-family: "Inter", "Segoe UI", sans-serif;
    margin: 0;
    min-height: 100dvh;
    background-color: var(--color-background);
    color: var(--color-white);
  }

  h1,
  h2,
  h3,
  h4 {
    text-wrap: balance;
    margin: 0;
  }

  p {
    text-wrap: pretty;
    margin: 0;
  }

  section{
    margin-bottom: var(--margin-xxxlarge);
  }
</style>

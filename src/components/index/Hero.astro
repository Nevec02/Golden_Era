---
import Button from "../atoms/Button.astro";
---

<section class="hero">
  <div class="hero__media" aria-hidden="true">
    <video autoplay muted loop playsinline preload="metadata" poster="/images/Shortfilm_EsRetina.webp">
      <source src="/videos/FilmShotsResume.webm" type="video/webm" />
      <source src="/videos/FilmShotsResume.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="hero__wash" aria-hidden="true"></div>

  <div class="hero__content shell">
    <p class="eyebrow js-hero-reveal">Productora audiovisual · Asturias</p>
    <h1 class="max-w-display js-hero-reveal">
      Imágenes que <span class="text-gold">mueven algo.</span>
    </h1>
    <p class="hero__lead js-hero-reveal">
      Cine, videoclips y contenido de marca con una dirección visual que no se olvida al terminar el plano.
    </p>
    <div class="hero__actions js-hero-reveal">
      <Button href="/proyectos" text="Ver proyectos" icon="ph-play" />
      <Button href="/contacto" type="secondary" text="Crear juntos" />
    </div>
  </div>

  <div class="hero__foot shell js-hero-reveal">
    <span>Dirección · Producción · Postproducción</span>
    <a href="#manifiesto">Descubre el estudio <i class="ph ph-arrow-down" aria-hidden="true"></i></a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    place-items: center;
    overflow: hidden;
    padding: 15rem 0 9rem;
    isolation: isolate;
  }

  .hero__media,
  .hero__wash {
    position: absolute;
    z-index: -2;
    inset: 0;
  }

  .hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.72) contrast(1.12) brightness(0.7);
  }

  .hero__wash {
    z-index: -1;
    background:
      radial-gradient(circle at center, rgba(14, 11, 2, 0.18), rgba(14, 11, 2, 0.82) 78%),
      linear-gradient(180deg, rgba(14, 11, 2, 0.5), transparent 34%, rgba(14, 11, 2, 0.88));
  }

  .hero__content {
    display: flex;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  h1 {
    margin-top: clamp(2rem, 4vw, 5rem);
  }

  h1 span {
    display: block;
  }

  .hero__lead {
    max-width: 58ch;
    margin-top: 3.2rem;
    color: var(--color-text-soft);
    font-size: clamp(1.8rem, 1.3rem + 0.8vw, 2.6rem);
    font-weight: 520;
    line-height: 1.35;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
    margin-top: 3.4rem;
  }

  .hero__foot {
    position: absolute;
    right: 0;
    bottom: 2.4rem;
    left: 0;
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    color: var(--color-text-muted);
    font-size: 1.2rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__foot a {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--color-text-soft);
    text-decoration: none;
  }

  @media (max-width: 767px) {
    .hero {
      padding-top: 13rem;
    }

    .hero__content {
      align-items: flex-start;
      text-align: left;
    }

    h1 span {
      display: inline;
    }

    .hero__actions {
      justify-content: flex-start;
    }

    .hero__foot span {
      display: none;
    }

    .hero__foot {
      justify-content: flex-end;
    }
  }
</style>

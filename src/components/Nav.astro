---
const currentPath = Astro.url.pathname;
const links = [
  { href: "/proyectos", label: "Proyectos" },
  { href: "/servicios", label: "Servicios" },
  { href: "/sobre-nosotros", label: "Estudio" },
];
---

<header class="site-header">
  <nav class="nav shell" aria-label="Navegación principal">
    <a href="/" class="brand" aria-label="Golden Era, inicio">
      <img src="/images/sideGoldenera.svg" alt="" width="178" height="48" />
    </a>

    <div class="nav__links" id="site-menu">
      {links.map((link) => (
        <a href={link.href} aria-current={currentPath === link.href ? "page" : undefined}>
          {link.label}
        </a>
      ))}
      <a class="nav__contact" href="/contacto">
        Hablemos <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
      </a>
    </div>

    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Abrir menú">
      <i class="ph ph-list" aria-hidden="true"></i>
    </button>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    z-index: 100;
    top: 0;
    left: 0;
    width: 100%;
    padding-top: 1.6rem;
    pointer-events: none;
  }

  .nav {
    display: flex;
    min-height: 6.4rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 0.8rem 0.8rem 1.8rem;
    border: 1px solid rgba(240, 212, 145, 0.2);
    border-radius: 999px;
    background: rgba(14, 11, 2, 0.76);
    box-shadow: 0 1.8rem 5rem rgba(0, 0, 0, 0.24);
    backdrop-filter: blur(18px);
    pointer-events: auto;
  }

  .brand {
    flex: 0 0 auto;
  }

  .brand img {
    width: clamp(12rem, 12vw, 17.8rem);
    height: auto;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1.8rem, 2.4vw, 3.8rem);
  }

  .nav__links > a:not(.nav__contact) {
    position: relative;
    padding-block: 1rem;
    color: var(--color-text-soft);
    font-size: 1.4rem;
    font-weight: 620;
    text-decoration: none;
  }

  .nav__links > a:not(.nav__contact)::after {
    position: absolute;
    right: 0;
    bottom: 0.5rem;
    left: 0;
    height: 1px;
    content: "";
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 280ms var(--ease-out);
  }

  .nav__links > a:hover::after,
  .nav__links > a[aria-current="page"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav__contact {
    display: inline-flex;
    min-height: 4.6rem;
    align-items: center;
    gap: 0.8rem;
    padding-inline: 2rem;
    border-radius: 999px;
    background: var(--color-gold);
    color: var(--color-ink);
    font-size: 1.4rem;
    font-weight: 760;
    text-decoration: none;
    transition: background 220ms ease, transform 220ms var(--ease-out);
  }

  .nav__contact:hover {
    background: var(--color-gold-light);
    transform: translateY(-2px);
  }

  .nav__toggle {
    display: none;
    width: 4.8rem;
    height: 4.8rem;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-ink);
    cursor: pointer;
    font-size: 2.4rem;
  }

  @media (max-width: 767px) {
    .site-header {
      padding-top: 1rem;
    }

    .nav {
      min-height: 5.8rem;
      padding-left: 1.4rem;
    }

    .nav__toggle {
      display: grid;
    }

    .nav__links {
      position: fixed;
      z-index: -1;
      top: 0;
      right: 0;
      display: flex;
      width: min(38rem, 100%);
      height: 100svh;
      align-items: stretch;
      justify-content: center;
      flex-direction: column;
      gap: 1.2rem;
      padding: 11rem 2.4rem 3rem;
      background: var(--color-gold);
      color: var(--color-ink);
      transform: translateX(105%);
      transition: transform 460ms var(--ease-out);
    }

    .nav__links.is-open {
      transform: translateX(0);
    }

    .nav__links > a:not(.nav__contact) {
      padding: 1.1rem 0;
      border-bottom: 1px solid rgba(14, 11, 2, 0.28);
      color: var(--color-ink);
      font-size: clamp(3.8rem, 12vw, 6rem);
      font-weight: 720;
      letter-spacing: -0.05em;
      line-height: 1;
    }

    .nav__contact {
      width: 100%;
      justify-content: space-between;
      margin-top: auto;
      border: 1px solid var(--color-ink);
      background: var(--color-ink);
      color: var(--color-gold);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".nav__toggle");
  const menu = document.querySelector<HTMLElement>(".nav__links");
  const icon = toggle?.querySelector("i");

  const closeMenu = () => {
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Abrir menú");
    menu?.classList.remove("is-open");
    icon?.classList.remove("ph-x");
    icon?.classList.add("ph-list");
    document.body.style.overflow = "";
  };

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    if (isOpen) {
      closeMenu();
      return;
    }
    toggle.setAttribute("aria-expanded", "true");
    toggle.setAttribute("aria-label", "Cerrar menú");
    menu?.classList.add("is-open");
    icon?.classList.remove("ph-list");
    icon?.classList.add("ph-x");
    document.body.style.overflow = "hidden";
  });

  menu?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>

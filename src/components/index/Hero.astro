---
import { Image } from "astro:assets";
import Logo from "../../assets/logos/goldenera.svg";
---

<section>
  <div class="hero">
    <div class="hero-gradient" aria-hidden="true"></div>
    <div class="hero-video">
      <video autoplay muted loop playsinline>
        <source src="/videos/GoldenBackgroundSlow.webm" type="video/webm" />
      </video>
    </div>
    <div class="hero-content">
      <Image
        src={Logo}
        alt="Golden Era Logo"
        width="1800"
        height="600"
        loading={"eager"}
      />
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    width: 100%;
    height: 100dvh;
    z-index: -1;
  }

  .hero-gradient {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      0deg,
      rgba(14, 11, 2, 1) 0%,
      rgba(14, 11, 2, 0) 20%,
      rgba(14, 11, 2, 0) 100%
    );
    z-index: -1;
  }
  .hero-video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.5);
  }

  .hero-content {
    z-index: 1;
    display: flex;
    padding: 0 2rem 15rem 2rem;
  }

  @media (max-width: 768px) {
    .hero-content {
      width: 100%;
      text-align: center;
    }
  }
</style>

---
import Button from "../atoms/Button.astro";

const services = [
  { title: "Cine", text: "Cortometrajes y piezas narrativas donde cada plano empuja la historia.", image: "/images/golden-era-service-cine.png", icon: "ph-film-strip" },
  { title: "Videoclips", text: "Universos visuales para artistas que quieren sonar también con los ojos.", image: "/images/golden-era-service-videoclips.png", icon: "ph-music-notes" },
  { title: "Marcas", text: "Campañas, producto y contenido que traduce estrategia en deseo.", image: "/images/golden-era-service-marcas.png", icon: "ph-megaphone" },
  { title: "Experimental", text: "Motion, instalaciones y formatos que todavía no tienen una etiqueta cómoda.", image: "/images/golden-era-service-experimental.png", icon: "ph-sparkle" },
];
---

<section class="services chapter">
  <div class="services__head shell">
    <p class="eyebrow">Lo que hacemos</p>
    <h2 class="section-title">Una misma mirada. <span class="editorial text-gold">Muchos formatos.</span></h2>
  </div>

  <div class="service-stage shell">
    <div class="service-stage__visuals" aria-live="polite">
      {services.map((service, index) => (
        <figure class:list={["service-visual", { "is-active": index === 0 }]} data-service-visual={index}>
          <img src={service.image} alt={`Dirección visual para el servicio ${service.title}`} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
          <figcaption>
            <span class="service-visual__index">0{index + 1}</span>
            <span class="service-visual__copy">
              <strong>{service.title}</strong>
              <small>{service.text}</small>
            </span>
          </figcaption>
        </figure>
      ))}
      <button class="service-stage__autoplay" type="button" data-service-autoplay aria-pressed="false" aria-label="Pausar rotación automática">
        <i class="ph ph-pause" aria-hidden="true"></i>
        <span>Pausar</span>
      </button>
      <div class="service-stage__stamp" aria-hidden="true">
        <i class="ph ph-play" aria-hidden="true"></i>
        <span>Imagen<br />en movimiento</span>
      </div>
      <div class="service-stage__progress" aria-hidden="true"><span></span></div>
    </div>

    <div class="service-list">
      {services.map((service, index) => (
        <button
          class:list={["service-row", { "is-active": index === 0 }]}
          type="button"
          data-service-trigger={index}
          aria-pressed={index === 0 ? "true" : "false"}
        >
          <span class="service-row__index">0{index + 1}</span>
          <i class:list={["ph", service.icon, "service-row__icon"]} aria-hidden="true"></i>
          <span class="service-row__copy">
            <strong>{service.title}</strong>
            <span>{service.text}</span>
          </span>
          <i class="ph ph-arrow-down-left service-row__arrow" aria-hidden="true"></i>
        </button>
      ))}
      <div class="service-list__footer">
        <p>Del primer gesto al último fotograma.</p>
        <Button href="/servicios" type="secondary" text="Conocer servicios" />
      </div>
    </div>
  </div>
</section>

<script>
  const initServiceStage = () => {
    const stages = document.querySelectorAll<HTMLElement>(".service-stage");

    stages.forEach((stage) => {
      if (stage.dataset.ready === "true") return;
      stage.dataset.ready = "true";

      const triggers = Array.from(stage.querySelectorAll<HTMLButtonElement>("[data-service-trigger]"));
      const visuals = Array.from(stage.querySelectorAll<HTMLElement>("[data-service-visual]"));
      const autoplayButton = stage.querySelector<HTMLButtonElement>("[data-service-autoplay]");
      const progress = stage.querySelector<HTMLElement>(".service-stage__progress span");
      const responsiveQuery = window.matchMedia("(max-width: 900px)");
      const reduceMotionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
      const autoDelay = 4500;
      let activeIndex = 0;
      let timer: number | undefined;
      let progressAnimation: Animation | undefined;
      let isVisible = false;
      let isPaused = false;

      const canAutoplay = () => responsiveQuery.matches && !reduceMotionQuery.matches && isVisible && !isPaused && !document.hidden;

      const stopAutoplay = () => {
        if (timer) window.clearTimeout(timer);
        timer = undefined;
        progressAnimation?.cancel();
        progressAnimation = undefined;
      };

      const scheduleAutoplay = () => {
        stopAutoplay();
        if (!canAutoplay()) return;

        if (progress) {
          progressAnimation = progress.animate(
            [{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }],
            { duration: autoDelay, easing: "linear", fill: "forwards" },
          );
        }

        timer = window.setTimeout(() => {
          activate((activeIndex + 1) % triggers.length, false);
          scheduleAutoplay();
        }, autoDelay);
      };

      const activate = (index: number, restartTimer = true) => {
        activeIndex = index;
        triggers.forEach((trigger, triggerIndex) => {
          const isActive = triggerIndex === index;
          trigger.classList.toggle("is-active", isActive);
          trigger.setAttribute("aria-pressed", String(isActive));
        });
        visuals.forEach((visual, visualIndex) => visual.classList.toggle("is-active", visualIndex === index));
        if (restartTimer) scheduleAutoplay();
      };

      triggers.forEach((trigger, index) => {
        trigger.addEventListener("pointerenter", () => activate(index));
        trigger.addEventListener("focus", () => activate(index));
        trigger.addEventListener("click", () => activate(index));
      });

      autoplayButton?.addEventListener("click", () => {
        isPaused = !isPaused;
        autoplayButton.setAttribute("aria-pressed", String(isPaused));
        autoplayButton.setAttribute("aria-label", isPaused ? "Reanudar rotación automática" : "Pausar rotación automática");
        autoplayButton.querySelector("span")!.textContent = isPaused ? "Reanudar" : "Pausar";
        autoplayButton.querySelector("i")!.className = `ph ${isPaused ? "ph-play" : "ph-pause"}`;
        scheduleAutoplay();
      });

      const visibilityObserver = new IntersectionObserver(
        ([entry]) => {
          isVisible = entry.isIntersecting;
          scheduleAutoplay();
        },
        { rootMargin: "-18% 0px -18% 0px" },
      );

      visibilityObserver.observe(stage);
      responsiveQuery.addEventListener("change", scheduleAutoplay);
      reduceMotionQuery.addEventListener("change", scheduleAutoplay);
      document.addEventListener("visibilitychange", scheduleAutoplay);
    });
  };

  initServiceStage();
  document.addEventListener("astro:page-load", initServiceStage);
</script>

<style>
  .services__head {
    display: grid;
    grid-template-columns: 1fr 2fr;
    align-items: end;
    gap: 5rem;
    margin-bottom: clamp(5rem, 8vw, 10rem);
  }

  .service-stage {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(48rem, 1.12fr);
    gap: clamp(2rem, 4vw, 7rem);
    align-items: start;
  }

  .service-stage__visuals {
    position: relative;
    overflow: hidden;
    min-height: min(76rem, 78vh);
    border-radius: var(--radius-sm);
    isolation: isolate;
    background: var(--color-gold-dark);
  }

  .service-visual {
    position: absolute;
    inset: 0;
    margin: 0;
    clip-path: inset(100% 0 0);
    opacity: 0;
    transform: scale(1.08);
    transition:
      clip-path 800ms var(--ease-out),
      opacity 250ms ease,
      transform 1100ms var(--ease-out);
  }

  .service-visual.is-active {
    z-index: 1;
    clip-path: inset(0);
    opacity: 1;
    transform: scale(1);
  }

  .service-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) saturate(0.82) brightness(0.82);
  }

  .service-visual::after {
    position: absolute;
    content: "";
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(9, 7, 2, 0.82));
  }

  .service-visual figcaption {
    position: absolute;
    z-index: 2;
    right: 2.4rem;
    bottom: 2.4rem;
    left: 2.4rem;
    display: flex;
    justify-content: space-between;
    color: var(--color-text);
    font-size: clamp(3.8rem, 5vw, 7rem);
    font-weight: 720;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .service-visual__index {
    color: var(--color-gold-light);
    font-size: 1.3rem;
    letter-spacing: 0.14em;
  }

  .service-visual__copy {
    display: grid;
    text-align: right;
  }

  .service-visual__copy strong {
    font: inherit;
  }

  .service-visual__copy small {
    display: none;
  }

  .service-stage__autoplay,
  .service-stage__progress {
    display: none;
  }

  .service-stage__stamp {
    position: absolute;
    z-index: 3;
    top: 2rem;
    right: 2rem;
    display: flex;
    width: 12rem;
    height: 12rem;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    border-radius: 50%;
    background: var(--color-gold);
    color: var(--color-ink);
    font-size: 1.1rem;
    font-weight: 760;
    letter-spacing: 0.06em;
    line-height: 1.1;
    text-transform: uppercase;
    animation: breathe 3.4s ease-in-out infinite;
  }

  .service-stage__stamp i { font-size: 2rem; }

  .service-list {
    border-top: 1px solid var(--color-line);
  }

  .service-row {
    position: relative;
    display: grid;
    overflow: hidden;
    width: 100%;
    min-height: 14.5rem;
    grid-template-columns: 4rem 5rem 1fr 4rem;
    align-items: center;
    gap: clamp(1.2rem, 2vw, 2.8rem);
    padding: 2.4rem 1.4rem;
    border: 0;
    border-bottom: 1px solid var(--color-line);
    background: transparent;
    color: var(--color-text);
    text-align: left;
    cursor: pointer;
    isolation: isolate;
  }

  .service-row::before {
    position: absolute;
    z-index: -1;
    content: "";
    inset: 0;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 560ms var(--ease-out);
  }

  .service-row.is-active::before,
  .service-row:hover::before,
  .service-row:focus-visible::before {
    transform: scaleX(1);
    transform-origin: left;
  }

  .service-row.is-active,
  .service-row:hover,
  .service-row:focus-visible {
    color: var(--color-ink);
  }

  .service-row:focus-visible { outline: 2px solid var(--color-text); outline-offset: 3px; }

  .service-row__index {
    align-self: start;
    padding-top: 0.7rem;
    font-size: 1.1rem;
    font-weight: 740;
    letter-spacing: 0.12em;
  }

  .service-row__icon {
    display: grid;
    width: 4.8rem;
    height: 4.8rem;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 2.1rem;
  }

  .service-row__copy {
    display: grid;
    gap: 0.8rem;
  }

  .service-row__copy strong {
    font-size: clamp(3rem, 3.5vw, 5.5rem);
    letter-spacing: -0.05em;
    line-height: 0.95;
  }

  .service-row__copy > span {
    max-width: 48ch;
    color: var(--color-text-muted);
    font-size: 1.45rem;
    transition: color 350ms ease, transform 500ms var(--ease-out);
  }

  .service-row.is-active .service-row__copy > span,
  .service-row:hover .service-row__copy > span,
  .service-row:focus-visible .service-row__copy > span {
    color: rgba(14, 11, 2, 0.74);
    transform: translateX(0.6rem);
  }

  .service-row__arrow {
    font-size: 2.4rem;
    transform: rotate(45deg);
    transition: transform 500ms var(--ease-out);
  }

  .service-row.is-active .service-row__arrow,
  .service-row:hover .service-row__arrow { transform: rotate(0); }

  .service-list__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 3rem;
  }

  .service-list__footer p {
    max-width: 20ch;
    color: var(--color-text-muted);
  }

  @keyframes breathe {
    50% { transform: scale(0.94) rotate(-4deg); }
  }

  @media (max-width: 900px) {
    .services__head { grid-template-columns: 1fr; }

    .service-stage {
      display: grid;
      grid-template-columns: 1fr;
    }

    .service-stage__visuals {
      min-height: clamp(38rem, 58svh, 56rem);
    }

    .service-visual figcaption {
      right: clamp(2rem, 5vw, 3.2rem);
      bottom: clamp(2.6rem, 6vw, 4rem);
      left: clamp(2rem, 5vw, 3.2rem);
      align-items: flex-start;
      flex-direction: column;
      gap: 1.2rem;
    }

    .service-visual__copy {
      gap: 1rem;
      text-align: left;
    }

    .service-visual__copy strong {
      font-size: clamp(4rem, 9vw, 7rem);
    }

    .service-visual__copy small {
      display: block;
      max-width: 38ch;
      color: var(--color-text-soft);
      font-family: var(--font-body);
      font-size: clamp(1.4rem, 2.2vw, 1.7rem);
      font-weight: 480;
      letter-spacing: 0;
      line-height: 1.45;
    }

    .service-stage__autoplay {
      position: absolute;
      z-index: 4;
      top: 2rem;
      left: 2rem;
      display: inline-flex;
      min-height: 4.4rem;
      align-items: center;
      gap: 0.8rem;
      padding: 0.8rem 1.4rem;
      border: 1px solid rgba(255, 255, 255, 0.38);
      border-radius: 999px;
      background: rgba(14, 11, 2, 0.72);
      color: var(--color-text);
      font-size: 1.2rem;
      font-weight: 700;
      cursor: pointer;
      backdrop-filter: blur(1rem);
    }

    .service-stage__autoplay:active { transform: scale(0.97); }

    .service-stage__progress {
      position: absolute;
      z-index: 4;
      right: 0;
      bottom: 0;
      left: 0;
      display: block;
      height: 0.4rem;
      background: rgba(255, 255, 255, 0.18);
    }

    .service-stage__progress span {
      display: block;
      width: 100%;
      height: 100%;
      background: var(--color-gold);
      transform: scaleX(0);
      transform-origin: left;
    }

    .service-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .service-row {
      min-height: 9.6rem;
      grid-template-columns: 2.8rem 1fr 2.8rem;
      gap: 1rem;
      padding: 1.8rem 1.4rem;
    }

    .service-row:nth-child(odd) { border-right: 1px solid var(--color-line); }
    .service-row__icon { display: none; }
    .service-row__copy > span { display: none; }
    .service-row__copy strong { font-size: clamp(2.2rem, 4vw, 3.4rem); }

    .service-list__footer {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .service-stage__visuals { min-height: clamp(36rem, 56svh, 48rem); }
    .service-stage__stamp { width: 9rem; height: 9rem; font-size: 0.9rem; }

    .service-list { grid-template-columns: 1fr; }

    .service-row {
      min-height: 7.4rem;
    }

    .service-row:nth-child(odd) { border-right: 0; }

    .service-list__footer { align-items: flex-start; flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-stage__stamp { animation: none; }
    .service-stage__autoplay,
    .service-stage__progress { display: none; }
    .service-visual,
    .service-row::before,
    .service-row__copy > span,
    .service-row__arrow { transition: none; }
  }
</style>

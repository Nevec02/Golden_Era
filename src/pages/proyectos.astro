---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import GoldenTouch from "../components/index/GoldenTouch.astro";
import Button from "../components/atoms/Button.astro";
---

<Layout title="Proyectos — Golden Era" description="Selección de cortometrajes, videoclips y producción de marca de Golden Era.">
  <PageHero
    eyebrow="Archivo Golden Era"
    title="Trabajo que"
    accent="deja huella."
    description="Una selección de mundos, campañas y relatos construidos desde la primera idea hasta el último ajuste de color."
    video="/videos/cocotext.webm"
    image="/images/Shortfilm_EsRetina.webp"
    actionHref="#archivo"
    actionText="Explorar proyectos"
  />

  <div id="archivo"><GoldenTouch /></div>

  <section class="reel chapter">
    <div class="shell reel__grid">
      <div class="reel__copy">
        <p class="eyebrow">Detrás de los frames</p>
        <h2 class="section-title">La técnica al servicio de <span class="editorial text-gold">la emoción.</span></h2>
        <p>Preproducción, rodaje y postproducción conviven dentro del mismo criterio creativo para que cada decisión sume.</p>
        <Button href="/contacto" text="Producir una idea" />
      </div>
      <div class="reel__media">
        <video autoplay muted loop playsinline preload="metadata" poster="/images/OurCamera.png">
          <source src="/videos/GoldenEraLogo_animation.webm" type="video/webm" />
          <source src="/videos/GoldenEraLogo_animation.mp4" type="video/mp4" />
        </video>
      </div>
    </div>
  </section>
</Layout>

<style>
  .reel { background: var(--color-surface); }
  .reel__grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(5rem, 9vw, 14rem); align-items: center; }
  .reel__copy h2 { margin-top: 2.4rem; }
  .reel__copy > p:not(.eyebrow) { max-width: 44ch; margin: 3rem 0; color: var(--color-text-muted); }
  .reel__media { overflow: hidden; aspect-ratio: 4 / 5; border-radius: var(--radius-md); }
  .reel__media video { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 800px) { .reel__grid { grid-template-columns: 1fr; } .reel__media { aspect-ratio: 4 / 3; } }
</style>

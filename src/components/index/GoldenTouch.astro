---
import Button from "../atoms/Button.astro";
---

<section>
  <div class="main-container">
    <h2>
      No creemos en lo convencional. En Golden Era, cada proyecto es una
      exploración de nuevas formas de contar historias, de romper límites y de
      conectar con las personas de una manera única.
    </h2>
  </div>
</section>

<style>
  .main-container {
    display: flex;
    flex-direction: column;
    align-items: start;
    padding: 0 5rem;
  }

  .main-container h2 {
    font-size: clamp(var(--font-size-medium), 15vw, var(--font-size-xxlarge));
    max-width: 80%;
  }

  @media (max-width: 768px) {

    .main-container{
      padding: 0 0 0 1.5rem;
    }
      .main-container h2 {
        font-size: clamp(var(--font-size-medium), 8vw, var(--font-size-xlarge));
        max-width: 100%;
      }
  }

</style>

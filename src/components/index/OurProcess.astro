<script>
import gsap from "gsap";
import ScrollTrigger from "gsap/src/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray(".steps").forEach((step, i) => {
    ScrollTrigger.create({
      trigger: step as HTMLElement,
      start: "top top",
      end: "+=100%",
      pin: true,
      pinSpacing: false,
      markers: false,
  });
});
</script>
<section class="manifesto chapter" id="manifiesto">
  <div class="marquee" aria-label="Formatos audiovisuales">
    <div class="marquee__track">
      <span>Cortometrajes</span><i class="ph ph-asterisk" aria-hidden="true"></i>
      <span>Videoclips</span><i class="ph ph-asterisk" aria-hidden="true"></i>
      <span>Branded content</span><i class="ph ph-asterisk" aria-hidden="true"></i>
      <span>Dirección creativa</span><i class="ph ph-asterisk" aria-hidden="true"></i>
      <span>Cortometrajes</span><i class="ph ph-asterisk" aria-hidden="true"></i>
      <span>Videoclips</span><i class="ph ph-asterisk" aria-hidden="true"></i>
      <span>Branded content</span><i class="ph ph-asterisk" aria-hidden="true"></i>
      <span>Dirección creativa</span>
    </div>
  </div>

  <div class="manifesto__body shell">
    <video class="manifesto__video" autoplay muted loop playsinline preload="auto" aria-hidden="true">
      <source src="/videos/GoldenBackgroundSlow.webm" type="video/webm" />
    </video>
    <div class="manifesto__veil" aria-hidden="true"></div>

    <div class="manifesto__copy">
      <p class="eyebrow">Golden Era no es solo una productora</p>
      <p class="manifesto__statement js-scrub-copy">
        Convertimos ideas salvajes en imágenes precisas. Unimos estrategia,
        oficio y riesgo para crear historias que merecen ser vistas.
      </p>
    </div>

    <div class="manifesto__facts">
      <div><strong>360º</strong><span>Del concepto a la entrega final</span></div>
      <div><strong>01</strong><span>Un equipo, una visión, un resultado</span></div>
      <div><strong>∞</strong><span>Formas de contar la historia</span></div>
    </div>
  </div>
</section>

<script>
  const initManifestoVideo = () => {
    const videos = document.querySelectorAll<HTMLVideoElement>(".manifesto__video");

    videos.forEach((video) => {
      if (video.dataset.playbackReady === "true") return;
      video.dataset.playbackReady = "true";
      video.muted = true;
      video.defaultMuted = true;
      video.loop = true;

      let isVisible = false;

      const play = () => {
        if (!isVisible || document.hidden) return;
        void video.play().catch(() => {
          // Muted autoplay can still be deferred by browser power-saving modes.
        });
      };

      const restart = () => {
        video.currentTime = 0;
        play();
      };

      const observer = new IntersectionObserver(
        ([entry]) => {
          isVisible = entry.isIntersecting;
          if (isVisible) play();
        },
        { threshold: 0.08 },
      );

      observer.observe(video);
      video.addEventListener("canplay", play);
      video.addEventListener("ended", restart);
      document.addEventListener("visibilitychange", play);
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initManifestoVideo, { once: true });
  } else {
    initManifestoVideo();
  }

  document.addEventListener("astro:page-load", initManifestoVideo);
</script>


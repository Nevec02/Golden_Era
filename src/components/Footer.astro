---
import { Image } from "astro:assets";
import FooterLogo from "../assets/logos/sideblack.svg";

import Button from "../components/atoms/Button.astro";
---

<footer>
  <div class="footer-container">
    <div class="footer-head">
      <h2>DISEÑO Y PRODUCCIÓN AUDIOVISUAL</h2>
      <Button href="/contacto" type="button black" text="Contacta" />
    </div>
    <hr />
    <div class="footer-body">
      <div class="footer-column">
        <h3>Index</h3>
        <ul class="footer-list">
          <li><a href="/">Inicio</a></li>
          <li><a href="/servicios">Servicios</a></li>
          <li><a href="/proyectos">Proyectos</a></li>
          <li><a href="/sobre-nosotros">Sobre nosotros</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </div>
      <div class="footer-column">
        <h3>Social media</h3>
        <ul class="footer-list">
          <li><a href="https://www.instagram.com/goldenera_studios?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw==" target="_blank" rel="noopener noreferrer">Instagram</a></li>
          <li><a href="https://www.youtube.com/@GoldenEraStudios" target="_blank" rel="noopener noreferrer">YouTube</a></li>
          <li><a href="https://www.facebook.com/people/Golden-Era/61569511384557/" target="_blank" rel="noopener noreferrer">Facebook</a></li>
        </ul>
      </div>
      <div class="footer-column">
        <h3>Stuff</h3>
        <ul class="footer-list">
          <li><a href="/gijon-impulsa">Gijón Impulsa</a></li>
          <li><a href="/terminos-y-condiciones">Terminos y condiciones</a></li>
          <li><a href="/politica-de-privacidad">Política de privacidad</a></li>
          <li><a href="/cookies">Cookies</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-logo">
      <Image src={FooterLogo} alt="Golden Era Logo" width="1400" height="300" loading={"eager"} />
    </div>
  </div>
</footer>

<style>
  footer {
    display: flex;
    justify-content: center;
    background-color: var(--color-primary-500);
    border-radius: 5rem;
  }

  footer h2 {
    color: var(--color-black);
    font-size: var(--font-size-large);
    max-width: 20ch;
    margin: 0;
  }

  footer h3 {
    color: var(--color-black);
    text-transform: uppercase;
    font-weight: bold;
    margin: 0;
  }

  footer ul {
    list-style: none;
    padding: 0;
    margin-top: var(--margin-small);
  }

  footer ul li a:hover {
    color: var(--color-white);
    cursor: pointer;
  }

  footer ul li a:focus {
    color: var(--color-white);
    cursor: pointer;
  }

  .footer-container ul li a {
    color: var(--color-black);
    text-decoration: none;
  }

  hr {
    margin: 3.4rem 0;
    border: 1px solid var(--color-black);
  }

  .footer-container {
    width: 80%;
  }

  .footer-head {
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    margin-top: var(--margin-xlarge);
    margin-bottom: var(--margin-medium);
  }

  .footer-body {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-top: var(--margin-medium);
    margin-bottom: var(--margin-xxlarge);
  }

  .footer-list{
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .footer-logo {
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: var(--margin-large);
  }

  @media (max-width: 768px) {
      .footer-head{
          flex-direction: column;
          align-items: start;
          gap: 2rem;
      }

      .footer-body{
          flex-direction: column;
          gap: 2rem;
          margin-bottom: var(--margin-large);
      }
  }
</style>